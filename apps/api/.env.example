# ==========================================
# CareerOS API Service Environment Variables
# Copy this file to .env and configure local values.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==========================================

PORT=3001
NODE_ENV=development

# Database (PostgreSQL container mapped to host port 5433)
DATABASE_URL="postgresql://careeros_local_user:replace_with_secure_local_postgres_password@127.0.0.1:5433/careeros_local_dev?schema=public"

# Redis Queue & Cache
REDIS_URL="redis://:replace_with_secure_local_redis_password@127.0.0.1:6379"

# S3-Compatible Object Storage (MinIO)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="careeros_local_minio_admin"
S3_SECRET_KEY="replace_with_secure_local_minio_password"
S3_BUCKET="careeros-documents"
S3_FORCE_PATH_STYLE="true"
