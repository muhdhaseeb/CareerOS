# ==========================================
# CareerOS Local Development Infrastructure
# Copy this file to .env and configure local passwords.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==========================================

# PostgreSQL Configuration (Container maps to host port 5433 to preserve native Postgres on 5432)
POSTGRES_USER=careeros_local_user
POSTGRES_PASSWORD=replace_with_secure_local_postgres_password
POSTGRES_DB=careeros_local_dev
POSTGRES_PORT=5433

# Redis Configuration
REDIS_PASSWORD=replace_with_secure_local_redis_password
REDIS_PORT=6379

# MinIO (S3-Compatible Object Storage) Configuration
MINIO_ROOT_USER=careeros_local_minio_admin
MINIO_ROOT_PASSWORD=replace_with_secure_local_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
