{
  "name": "@careeros/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prisma:run": "node scripts/run-prisma.mjs",
    "generate": "node scripts/run-prisma.mjs generate",
    "migrate:dev": "node scripts/run-prisma.mjs migrate dev",
    "migrate:deploy": "node scripts/run-prisma.mjs migrate deploy",
    "migrate:status": "node scripts/run-prisma.mjs migrate status",
    "seed": "tsx prisma/seed.ts",
    "test:setup": "node scripts/setup-test-db.mjs",
    "test": "node scripts/setup-test-db.mjs && vitest run",
    "build": "node scripts/run-prisma.mjs generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.9.0"
  },
  "devDependencies": {
    "prisma": "6.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
